# Dev mode config — copy to .env and fill in real values.
# When installed (rabbit-agent), config lives at ~/.rabbit-agent/settings.json instead.

ANTHROPIC_API_KEY=sk-your-api-key-here

# API endpoint (default: Anthropic; use https://api.deepseek.com/anthropic for DeepSeek)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model ID (any Anthropic Messages API-compatible model)
MODEL_ID=claude-sonnet-4-6

# Optional: fallback model on repeated 529 errors
# FALLBACK_MODEL_ID=claude-haiku-4-5
